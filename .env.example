# Copia este archivo como .env antes de levantar Docker Compose.
# Usa una contraseña alfanumérica larga para evitar codificar caracteres de URL.
POSTGRES_USER=delimuu
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA_2026
POSTGRES_DB=delimuu

# Puerto HTTP publicado en todas las interfaces del equipo anfitrión.
APP_PORT=8080

# Sesiones web. En desarrollo, agrega aquí el origen exacto de Vite si cambia.
SESSION_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173
# Mantén false para la red local HTTP. Usa true únicamente al publicar con HTTPS.
COOKIE_SECURE=false

# Solo se usan al ejecutar manualmente `npm run admin:bootstrap` en el backend.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_ADMINISTRATIVA

# Notificaciones: copia estas variables también a apps/backend/.env para desarrollo local.
# Aplica la migración antes de habilitarlas. No uses la contraseña del POS ni de Gmail.
NOTIFICATIONS_EMAIL_ENABLED=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Uno o varios destinatarios separados por coma.
NOTIFICATIONS_EMAIL_TO=
NOTIFICATIONS_PUSH_ENABLED=false
# Servidor ntfy HTTPS con tema reservado PRIVADO y token autorizado para publicar.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Solo para un tema público gratuito, aceptando exposición de los datos enviados.
# Un token no convierte por sí solo un tema en privado.
NTFY_ALLOW_PUBLIC_TOPIC=false

# Facturación electrónica Factus. Las credenciales reales solo deben existir
# en apps/backend/.env (desarrollo) o en el gestor de secretos del despliegue.
FACTUS_ENVIRONMENT=SANDBOX
FACTUS_CREDENTIAL_REFERENCE=FACTUS_SANDBOX
FACTUS_SANDBOX_CLIENT_ID=
FACTUS_SANDBOX_CLIENT_SECRET=
FACTUS_SANDBOX_USERNAME=
FACTUS_SANDBOX_PASSWORD=
