generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Durable delivery queue. Recipients and reports are snapshotted at event time.
model NotificationOutbox {
  id            Int      @id @default(autoincrement())
  deduplicationKey String @unique
  channel       String
  kind          String
  recipient     String
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lockedUntil   DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

model StockNotificationState {
  storeId          Int
  productVariantId Int
  level            String
  revision         Int      @default(1)
  updatedAt        DateTime @updatedAt

  @@id([storeId, productVariantId])
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  posVisible  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  productType ProductType @default(FINISHED_PRODUCT)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductType {
  INGREDIENT
  PACKAGING
  PREPARED_BASE
  FINISHED_PRODUCT
  RECIPE_PRODUCT
  THIRD_PARTY_PRODUCT
}

model ProductVariant {
  id                 Int             @id @default(autoincrement())
  name               String
  isActive           Boolean         @default(true)
  requirePreparation Boolean         @default(false)
  preparationArea    PreparationArea @default(KITCHEN)
  productCost        Float           @default(0)
  productId          Int
  unit               Unit            @default(UNIT)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())

  accountItems          AccountItem[]
  InventoryTransactions InventoryTransaction[]
  catalogItems          GroupCatalogItem[]
  storeInventories      StoreInventory[]
  inventoryLots         InventoryLot[]
  transferItems          InventoryTransferItem[]
  recipeItems           RecipeItem[]           @relation("RecipeOwner")
  ingredientInRecipes   RecipeItem[]           @relation("RecipeIngredient")
  shiftInventoryCountItems ShiftInventoryCountItem[]
}

enum PreparationArea {
  KITCHEN
}

enum Unit {
  UNIT
  GRAM
  KILOGRAM
  LITER
  MILLILITER
  PIECE
  BOX
  PACK
}

model RecipeItem {
  id Int @id @default(autoincrement())

  // Variante que contiene la receta
  recipeVariantId Int
  recipeVariant   ProductVariant @relation("RecipeOwner", fields: [recipeVariantId], references: [id], onDelete: Cascade)

  // Ingrediente utilizado
  ingredientVariantId Int
  ingredientVariant   ProductVariant @relation("RecipeIngredient", fields: [ingredientVariantId], references: [id])

  quantity Int

  createdAt DateTime @default(now())
}

model User {
  financialTransactionsCreated FinancialTransaction[] @relation("FinancialCreatedBy")
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(CASHIER)
  isActive      Boolean   @default(true)
  isGlobalAdmin Boolean   @default(false)
  lastLoginAt   DateTime?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  Accounts              Account[]              @relation("AccountCreatedBy")
  cancelledAccounts     Account[]              @relation("AccountCancelledBy")
  CashRegisters         CashRegister[]
  storeAccesses         UserStoreAccess[]
  sessions              UserSession[]
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionCreatedBy")
  dispatchedTransfers   InventoryTransfer[]    @relation("TransferDispatchedBy")
  receivedTransfers     InventoryTransfer[]    @relation("TransferReceivedBy")
  cancelledTransfers    InventoryTransfer[]    @relation("TransferCancelledBy")
  confirmedInventoryCounts ShiftInventoryCount[] @relation("InventoryCountConfirmedBy")
  countedInventoryItems ShiftInventoryCountItem[] @relation("InventoryItemCountedBy")
  resolvedInventoryItems ShiftInventoryCountItem[] @relation("InventoryItemResolvedBy")
}

enum Role {
  ADMIN
  CASHIER
  KITCHEN
  WAITER
  BAKERY
}

model Account {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation("AccountCreatedBy", fields: [userId], references: [id])
  name           String
  terminalId     Int
  terminal       Terminal      @relation(fields: [terminalId], references: [id])
  tableNumber    Int[]
  status         AccountStatus @default(OPEN)
  cashRegisterId Int?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accountItems   AccountItem[]
  kitchenTickets KitchenTicket[]

  total               Float          @default(0)
  discount            Float          @default(0)
  discountObservation String?
  closedAt            DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  cancelledByUserId   Int?
  cancelledByUser     User?          @relation("AccountCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  paymentMethod       PaymentMethod?
  customerId          Int?
  customer            Customer?      @relation(fields: [customerId], references: [id])

  financialTransactions FinancialTransaction[] @relation("AccountFinancialTransactions")

  financialTransactionId Int?

  @@index([cancelledByUserId])
}

enum AccountStatus {
  OPEN
  CLOSED
  CANCELLED
  CREDIT_PENDING
  CREDIT_PAID
}

enum PaymentMethod {
  CASH
  CARD
  QR
  CREDIT
}

model AccountItem {
  id               Int            @id @default(autoincrement())
  accountId        Int
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productName      String
  quantity         Int            @default(1)
  price            Float
  unitCost         Float          @default(0)
  subtotal         Float

  createdAt          DateTime            @default(now())
  kitchenTicketItems KitchenTicketItem[]

  @@unique([accountId, productVariantId])
}

model InventoryTransaction {
  id               Int                      @id @default(autoincrement())
  operationId      String?
  storeId          Int
  store            Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdByUserId  Int?
  createdByUser    User?                    @relation("InventoryTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  productVariantId Int
  inventoryLotId   Int?
  relatedAccountId Int?
  productVariant   ProductVariant           @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  inventoryLot     InventoryLot?             @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  quantity         Int
  unit             Unit                     @default(UNIT)
  type             InventoryTransactionType
  lossReason       InventoryLossReason?
  unitCost         Float?
  observation      String?

  createdAt DateTime @default(now())

  @@index([operationId])
  @@index([storeId, createdAt])
  @@index([createdByUserId])
  @@index([inventoryLotId])
  @@index([createdAt])
  @@index([type])
  @@index([lossReason])
}

enum InventoryTransactionType {
  SALE
  PURCHASE
  PRODUCTION
  RECEIPT
  ADJUSTMENT
  WASTE
  RETURN
  INITIAL
  WHOLESALE
  INTERNAL_CONSUMPTION
  DONATION
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_REVERSAL
}

enum InventoryLossReason {
  EXPIRATION
  DAMAGED
  PREPARATION_ERROR
  QUALITY_CONTROL
  OTHER
}

model FinancialTransaction {
  id                      Int                      @id @default(autoincrement())
  amount                  Float
  type                    FinancialTransactionType
  description             String?
  createdAt               DateTime                 @default(now())
  relatedCashRegisterId   Int?
  relatedAccountId        Int?
  cashRegister            CashRegister?            @relation(fields: [relatedCashRegisterId], references: [id], onDelete: Cascade)
  account                 Account?                 @relation(fields: [relatedAccountId], references: [id], onDelete: Cascade, name: "AccountFinancialTransactions")
  paymentMethod           PaymentMethod?
  adjustmentJustification String?
  voidedAt                DateTime?
  voidReason              String?
  voidedByUserId          Int?
  requestKey              String? @unique
  createdByUserId         Int?
  createdByUser           User? @relation("FinancialCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
}

enum FinancialTransactionType {
  SALE
  REFUND
  EXPENSE
  PURCHASE
  CASH_IN
  CASH_OUT
  ADJUSTMENT
  OPENING
}

model Customer {
  id    Int     @id @default(autoincrement())
  name  String
  phone String?
  email String?

  type CustomerType @default(RETAIL)

  createdAt DateTime @default(now())

  accounts Account[]
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

model CashRegister {
  id Int @id @default(autoincrement())

  userId     Int
  terminalId Int
  terminal   Terminal  @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  openedAt   DateTime
  closedAt   DateTime?

  openingAmount Float
  closingAmount Float?
  difference    Float?

  status CashRegisterStatus @default(OPEN)

  // Accumulated totals
  totalSales     Float @default(0)
  totalDiscounts Float @default(0)
  totalExpenses  Float @default(0)
  cashAmount     Float @default(0)
  cardAmount     Float @default(0)
  qrAmount       Float @default(0)
  creditAmount   Float @default(0)

  transactions FinancialTransaction[]
  accounts     Account[]

  user User @relation(fields: [userId], references: [id])
  inventoryCounts ShiftInventoryCount[]
}

model ShiftInventoryCount {
  id Int @id @default(autoincrement())
  cashRegisterId Int
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  phase String
  confirmedAt DateTime?
  confirmedByUserId Int?
  confirmedByUser User? @relation("InventoryCountConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now())
  archivedVerifications Json @default("[]")
  items ShiftInventoryCountItem[]

  @@unique([cashRegisterId, phase])
}

model ShiftInventoryCountItem {
  id Int @id @default(autoincrement())
  countId Int
  count ShiftInventoryCount @relation(fields: [countId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productVariantId Int
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productName String
  unit String
  expectedQuantity Int
  countedQuantity Int
  movementRevision Int
  difference Int
  justification String?
  countedAt DateTime @default(now())
  countedByUserId Int
  countedByUser User @relation("InventoryItemCountedBy", fields: [countedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resolution String?
  resolutionReason String?
  resolvedAt DateTime?
  resolvedByUserId Int?
  resolvedByUser User? @relation("InventoryItemResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  adjustmentOperationId String? @unique

  @@unique([countId, productVariantId])
  @@index([resolution, difference])
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model StoreGroup {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores       Store[]
  catalogItems GroupCatalogItem[]
  transfers    InventoryTransfer[]
}

model GroupCatalogItem {
  id               Int            @id @default(autoincrement())
  groupId          Int
  group            StoreGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  salePrice        Float?
  costPrice        Float
  posCode          String?
  isPosActive      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([groupId, productVariantId])
  @@unique([groupId, posCode])
  @@index([groupId, isPosActive])
}

enum KitchenMode {
  NONE
  TICKETS
}

model Store {
  id          Int         @id @default(autoincrement())
  groupId     Int
  group       StoreGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  code        String      @unique
  name        String
  isActive    Boolean     @default(true)
  kitchenMode KitchenMode @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminals             Terminal[]
  userAccesses          UserStoreAccess[]
  activeSessions        UserSession[]          @relation("ActiveStoreSessions")
  inventories           StoreInventory[]
  inventoryTransactions InventoryTransaction[]
  lotInventories        StoreLotInventory[]
  outgoingTransfers     InventoryTransfer[]    @relation("TransferOrigin")
  incomingTransfers     InventoryTransfer[]    @relation("TransferDestination")

  @@index([groupId, isActive])
}

model StoreInventory {
  id               Int            @id @default(autoincrement())
  storeId          Int
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  stock            Int            @default(0)
  minStock         Int            @default(0)
  isInitialized    Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([storeId, productVariantId])
  @@index([storeId, stock])
}

model InventoryLot {
  id               Int            @id @default(autoincrement())
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  code             String
  manufacturedAt   DateTime?      @db.Date
  expiresAt        DateTime?      @db.Date
  isLegacy         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  storeInventories      StoreLotInventory[]
  inventoryTransactions InventoryTransaction[]
  transferItems          InventoryTransferItem[]

  @@unique([productVariantId, code])
  @@index([expiresAt])
}

model StoreLotInventory {
  id             Int          @id @default(autoincrement())
  storeId        Int
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  inventoryLotId Int
  inventoryLot   InventoryLot @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  stock          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([storeId, inventoryLotId])
  @@index([storeId, stock])
  @@index([inventoryLotId])
}

enum InventoryTransferStatus {
  DISPATCHED
  RECEIVED
  CANCELLED
}

model InventoryTransfer {
  id                   Int                     @id @default(autoincrement())
  groupId              Int
  group                StoreGroup              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  originStoreId        Int
  originStore          Store                   @relation("TransferOrigin", fields: [originStoreId], references: [id], onDelete: Restrict)
  destinationStoreId   Int
  destinationStore     Store                   @relation("TransferDestination", fields: [destinationStoreId], references: [id], onDelete: Restrict)
  status               InventoryTransferStatus @default(DISPATCHED)
  dispatchedByUserId   Int
  dispatchedByUser     User                    @relation("TransferDispatchedBy", fields: [dispatchedByUserId], references: [id], onDelete: Restrict)
  receivedByUserId     Int?
  receivedByUser       User?                   @relation("TransferReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  cancelledByUserId    Int?
  cancelledByUser      User?                   @relation("TransferCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  dispatchObservation  String?
  receptionObservation String?
  discrepancyReason    String?
  cancellationReason   String?
  dispatchedAt         DateTime                @default(now())
  receivedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  items InventoryTransferItem[]

  @@index([groupId, status])
  @@index([originStoreId, dispatchedAt])
  @@index([destinationStoreId, status, dispatchedAt])
  @@index([dispatchedByUserId])
  @@index([receivedByUserId])
  @@index([cancelledByUserId])
}

model InventoryTransferItem {
  id               Int               @id @default(autoincrement())
  transferId       Int
  transfer         InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productVariantId Int
  productVariant   ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  inventoryLotId   Int
  inventoryLot     InventoryLot      @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  quantitySent     Int
  quantityReceived Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([transferId, productVariantId, inventoryLotId])
  @@index([productVariantId])
  @@index([inventoryLotId])
}

model Terminal {
  id       Int     @id @default(autoincrement())
  code     String
  name     String
  isActive Boolean @default(true)

  storeId Int
  store   Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registers      CashRegister[]
  accounts       Account[]
  activeSessions UserSession[]  @relation("ActiveTerminalSessions")

  @@unique([storeId, code])
  @@index([storeId, isActive])
}

model UserStoreAccess {
  id       Int     @id @default(autoincrement())
  userId   Int
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId  Int
  store    Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  role     Role
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
  @@index([storeId, role, isActive])
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  tokenHash        String    @unique
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeStoreId    Int?
  activeStore      Store?    @relation("ActiveStoreSessions", fields: [activeStoreId], references: [id], onDelete: SetNull)
  activeTerminalId Int?
  activeTerminal   Terminal? @relation("ActiveTerminalSessions", fields: [activeTerminalId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([activeStoreId])
  @@index([activeTerminalId])
}

model KitchenTicket {
  id Int @id @default(autoincrement())

  accountId Int
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  status       KitchenTicketStatus @default(PENDING)
  instructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       KitchenTicketItem[]
  adjustments KitchenTicketAdjustment[]

  @@index([accountId, status])
}

model KitchenTicketItem {
  id Int @id @default(autoincrement())

  kitchenTicketId Int
  accountItemId   Int
  productName     String
  quantity        Int

  kitchenTicket KitchenTicket @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)

  accountItem AccountItem               @relation(fields: [accountItemId], references: [id], onDelete: Restrict)
  adjustments KitchenTicketAdjustment[]

  @@index([kitchenTicketId])
}

enum KitchenTicketStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
}

model KitchenTicketAdjustment {
  id Int @id @default(autoincrement())

  kitchenTicketId     Int
  kitchenTicket       KitchenTicket     @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)
  kitchenTicketItemId Int
  kitchenTicketItem   KitchenTicketItem @relation(fields: [kitchenTicketItemId], references: [id], onDelete: Cascade)

  accountItemId    Int
  productName      String
  previousQuantity Int
  newQuantity      Int
  quantityDelta    Int
  status           KitchenTicketAdjustmentStatus @default(PENDING)
  createdAt        DateTime                      @default(now())
  acknowledgedAt   DateTime?

  @@index([kitchenTicketId, status])
  @@index([accountItemId])
}

enum KitchenTicketAdjustmentStatus {
  PENDING
  ACKNOWLEDGED
}

enum KitchenStatus {
  PENDING
  SENT
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}
